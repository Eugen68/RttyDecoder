<Window x:Class="RttyDecoder.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rtty="clr-namespace:RttyDecoder.Wpf;assembly=RttyDecoder.Wpf"
        Title="RTTY Decoder - YO9VA"
        Width="1100" Height="760" MinWidth="760" MinHeight="520"
        Background="{StaticResource Rtty.Background}">
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{x:Static ApplicationCommands.Open}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{x:Static ApplicationCommands.Save}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Open}" Executed="OnOpenWav" />
        <CommandBinding Command="{x:Static ApplicationCommands.Save}" Executed="OnSaveText" />
    </Window.CommandBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Fisier">
                <MenuItem Header="_Deschide WAV..." InputGestureText="Ctrl+O" Command="{x:Static ApplicationCommands.Open}" />
                <MenuItem Header="_Salveaza textul..." InputGestureText="Ctrl+S" Command="{x:Static ApplicationCommands.Save}" />
                <MenuItem Header="Salveaza lista _statiilor (CSV)..." Click="OnSaveStations" />
                <Separator />
                <MenuItem Header="_Iesire" InputGestureText="Alt+F4" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Indicative">
                <MenuItem Header="Deschide _folderul cu date" Click="OnOpenDataFolder"
                          ToolTip="cty.dat, MASTER.SCP si lista LoTW descarcate (%LOCALAPPDATA%\YO9VA\RttyDecoder)" />
                <MenuItem x:Name="UpdateDataItem" Header="_Actualizeaza datele acum" Click="OnUpdateData"
                          ToolTip="Verifica pe internet cty.dat, MASTER.SCP si LoTW si le foloseste imediat pe cele noi" />
                <MenuItem Header="_Starea datelor..." Click="OnDataStatus" />
            </MenuItem>
            <MenuItem Header="_Contest">
                <MenuItem Header="Deschide fereastra de _concurs..." Click="OnOpenContest" InputGestureText="Ctrl+Shift+C"
                          ToolTip="Fereastra separata: UDC, schimburi, seriale, jurnal, ADIF si Cabrillo" />
                <Separator />
                <MenuItem Header="Folder definitii _UDC" Click="OnContestDefinitionsFolder" />
                <MenuItem Header="Folder liste _SEC" Click="OnContestSupportFolder" />
                <MenuItem Header="Folder _sesiuni salvate" Click="OnContestSessionsFolder" />
            </MenuItem>
            <MenuItem Header="_Setari">
                <MenuItem Header="_Conexiune statie..." Click="OnRigSettings"
                          ToolTip="Direct pe portul serial (CAT Yaesu) sau prin OmniRig" />
                <MenuItem Header="_Reconecteaza statia" Click="OnRigReconnect" />
                <MenuItem Header="Setari _transmisie..." Click="OnTxSettings" ToolTip="FSK: preambul, pauza la sfarsit, limita, diddle, polaritate" />
                <Separator />
                <MenuItem Header="_Verificare online (QRZ.com / HamQTH.com)..." Click="OnLookupSettings"
                          ToolTip="Conturile pentru confirmarea online a indicativelor necunoscute local" />
                <Separator />
                <MenuItem Header="Deschide folderul _setarilor" Click="OnOpenSettingsFolder"
                          ToolTip="settings.json (%APPDATA%\YO9VA\RttyDecoder)" />
            </MenuItem>
            <MenuItem Header="_Ajutor">
                <MenuItem Header="_Ajutor..." Click="OnHelp" ToolTip="Explicatii pe subiecte: decodoare, reglaje, waterfall, A-TUNE si QSY, emisie, statie, fisiere, contest" />
                <Separator />
                <MenuItem Header="_Despre RTTY Decoder..." Click="OnAbout" />
            </MenuItem>
        </Menu>
        <rtty:RttyDecoderView x:Name="Decoder" />
    </DockPanel>
</Window>
