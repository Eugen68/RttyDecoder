<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RttyDecoder.App</RootNamespace>
    <AssemblyName>RttyDecoder</AssemblyName>
    <Product>RTTY Decoder</Product>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Iconita (turnul radio) din CwDecoder; ferestrele fara Icon propriu o folosesc pe a exe-ului. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Documentatia XML a bibliotecilor (HamCallsign.xml) nu trebuie langa exe. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RttyDecoder.Wpf\RttyDecoder.Wpf.csproj" />
  </ItemGroup>

</Project>
