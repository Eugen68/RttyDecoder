<Window x:Class="RttyDecoder.App.RigSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conexiune statie" Width="540" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Rtty.Background}" Foreground="{StaticResource Rtty.Foreground}"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Rtty.Foreground}" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="{StaticResource Rtty.Muted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- buton de reincarcare a porturilor: iconita Windows (Segoe MDL2 Assets) -->
        <Style TargetType="Button" x:Key="Refresh" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="Content" Value="&#xE72C;" />
            <Setter Property="ToolTip" Value="Reciteste porturile COM" />
        </Style>
    </Window.Resources>

    <!-- butoanele fixe jos; restul se deruleaza daca fereastra nu incape pe monitor -->
    <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="16,8,16,16">
        <StackPanel Orientation="Horizontal">
            <Button x:Name="TestButton" Content="Testeaza" Width="90" Click="OnTest"
                    ToolTip="Se conecteaza cu setarile de mai sus si citeste frecventa si modul" />
            <Button x:Name="PttTestButton" Content="Test PTT 0.5 s" Click="OnTestPtt"
                    ToolTip="Pune statia pe emisie o jumatate de secunda (fara audio: in DATA/SSB nu iese putere). Verifica antena/sarcina!" />
            <Button x:Name="KeyTestButton" Content="Test manipulare 0.5 s" Click="OnTestKey"
                    ToolTip="Activeaza pinul de manipulare o jumatate de secunda (fara emisie)" />
        </StackPanel>
        <!-- rezultatul testului sub butoane; un mesaj lung se deruleaza, nu umfla fereastra -->
        <ScrollViewer MaxHeight="72" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="TestStatus" TextWrapping="Wrap" />
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Anuleaza" Width="90" IsCancel="True" />
            <Button Content="Salveaza" Width="90" IsDefault="True" Style="{StaticResource Rtty.PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource Rtty.Border}" Margin="16,0" />

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16,16,16,8">
        <TextBlock Text="Cum e legata statia" FontWeight="Bold" Margin="0,0,0,4" />
        <RadioButton x:Name="KindNone" Content="Fara statie" Checked="OnKindChanged" />
        <RadioButton x:Name="KindDirect" Content="Direct pe portul serial (CAT Yaesu: FTX-1, FTDX10, FT-710, FT-991A...)" Checked="OnKindChanged" />
        <RadioButton x:Name="KindOmni" Content="Prin OmniRig (statia poate fi folosita si de alte programe)" Checked="OnKindChanged" />
        <RadioButton x:Name="KindHamlib" Content="Prin Hamlib (rigctld: Icom, Kenwood, Elecraft, Yaesu... ~280 de modele)" Checked="OnKindChanged" />

        <!-- DIRECT -->
        <Border x:Name="DirectPanel" Margin="0,10,0,0" Padding="10" BorderBrush="{StaticResource Rtty.Border}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Port CAT:" VerticalAlignment="Center" />
                    <ComboBox x:Name="CatPortBox" Grid.Row="0" Grid.Column="1" IsEditable="True" />
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Refresh}" Click="OnRefreshPorts" />

                    <TextBlock Grid.Row="1" Text="Viteza (baud):" VerticalAlignment="Center" />
                    <ComboBox x:Name="BaudBox" Grid.Row="1" Grid.Column="1" />

                    <TextBlock Grid.Row="2" Text="PTT:" VerticalAlignment="Center" />
                    <ComboBox x:Name="CatPttBox" Grid.Row="2" Grid.Column="1" SelectionChanged="OnPinChanged"
                              ToolTip="PTT pe un pin al portului CAT. Fara = PTT prin comanda CAT (TX1;)." />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="FTX-1 (cablu USB) apare ca doua porturi COM: primul (Enhanced) e CAT, al doilea (Standard) e pentru PTT/FSK pe RTS/DTR. Viteza trebuie sa fie aceeasi ca in meniul statiei (CAT RATE); implicit 38400. Fara pin de PTT ales, emisia se comanda prin CAT (TX1;)." />
            </StackPanel>
        </Border>

        <!-- OMNIRIG -->
        <Border x:Name="OmniPanel" Margin="0,10,0,0" Padding="10" BorderBrush="{StaticResource Rtty.Border}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="OmniRig:" VerticalAlignment="Center" />
                    <ComboBox x:Name="OmniRigBox" Grid.Column="1" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="OmniRig trebuie instalat si configurat pentru statie (tipul statiei, portul, viteza). Prin OmniRig se citesc si se schimba frecventa si modul; PTT-ul si manipularea se fac doar pe portul de mai jos." />
            </StackPanel>
        </Border>

        <!-- HAMLIB -->
        <Border x:Name="HamlibPanel" Margin="0,10,0,0" Padding="10" BorderBrush="{StaticResource Rtty.Border}" BorderThickness="1">
            <StackPanel>
                <CheckBox x:Name="HamlibStartBox" Content="Porneste rigctld din program (cu modelul, portul si viteza de mai jos)"
                          Foreground="{StaticResource Rtty.Foreground}" Checked="OnHamlibStartChanged" Unchecked="OnHamlibStartChanged" Margin="0,0,0,6" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="rigctld.exe:" VerticalAlignment="Center" />
                    <TextBox x:Name="HamlibPathBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource Rtty.Input}" Height="24" Margin="0,2"
                             ToolTip="Gol = cautat automat (PATH si Program Files\hamlib*\bin)" LostFocus="OnHamlibPathChanged" />
                    <Button Grid.Row="0" Grid.Column="2" Content="..." Width="28" Click="OnHamlibBrowse" ToolTip="Alege rigctld.exe" />

                    <TextBlock Grid.Row="1" Text="Model:" VerticalAlignment="Center" />
                    <ComboBox x:Name="HamlibModelBox" Grid.Row="1" Grid.Column="1" IsEditable="True" IsTextSearchEnabled="True"
                              ToolTip="Modelul statiei din lista Hamlib; se poate scrie si numarul (de ex. 1042 = FTDX-10)" />
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource Refresh}" Click="OnHamlibModels" ToolTip="Reciteste lista modelelor (rigctl -l)" />

                    <TextBlock Grid.Row="2" Text="Port statie:" VerticalAlignment="Center" />
                    <ComboBox x:Name="HamlibPortBox" Grid.Row="2" Grid.Column="1" IsEditable="True" Width="140" HorizontalAlignment="Left" />
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource Refresh}" Click="OnRefreshPorts" />

                    <TextBlock Grid.Row="3" Text="Viteza (baud):" VerticalAlignment="Center" />
                    <ComboBox x:Name="HamlibBaudBox" Grid.Row="3" Grid.Column="1" Width="140" HorizontalAlignment="Left" />

                    <TextBlock Grid.Row="4" Text="Adresa rigctld:" VerticalAlignment="Center" />
                    <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,2">
                        <TextBox x:Name="HamlibHostBox" Width="120" Style="{StaticResource Rtty.Input}" Height="24" />
                        <TextBlock Text=" : " VerticalAlignment="Center" />
                        <TextBox x:Name="HamlibTcpPortBox" Width="60" Style="{StaticResource Rtty.Input}" Height="24" />
                    </StackPanel>

                    <TextBlock Grid.Row="5" Text="Argumente:" VerticalAlignment="Center" />
                    <TextBox x:Name="HamlibArgsBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource Rtty.Input}" Height="24" Margin="0,2"
                             ToolTip="Argumente suplimentare pentru rigctld (de ex. --set-conf=serial_handshake=None). De obicei gol." />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="Hamlib se instaleaza separat (https://github.com/Hamlib/Hamlib/releases). Cu bifa, programul porneste rigctld si il opreste la iesire; fara bifa, se leaga la un rigctld deja pornit (de ex. folosit si de WSJT-X). Viteza trebuie sa fie ca in meniul statiei. PTT-ul prin Hamlib, sau pe un pin al portului de mai jos; manipularea FSK doar pe portul de mai jos." />
            </StackPanel>
        </Border>

        <!-- PORT MANIPULARE SI PTT -->
        <TextBlock x:Name="KeyHeader" Text="Port manipulare si PTT" FontWeight="Bold" Margin="0,14,0,4" />
        <Border x:Name="KeyPanel" Padding="10" BorderBrush="{StaticResource Rtty.Border}" BorderThickness="1">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Port:" VerticalAlignment="Center" />
                    <ComboBox x:Name="KeyPortBox" Grid.Row="0" Grid.Column="1" IsEditable="True" ToolTip="Gol = fara" />
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource Refresh}" Click="OnRefreshPorts" />
                    <TextBlock Grid.Row="1" Text="Viteza (baud):" VerticalAlignment="Center" />
                    <ComboBox x:Name="KeyBaudBox" Grid.Row="1" Grid.Column="1" />
                    <TextBlock Grid.Row="2" Text="PTT:" VerticalAlignment="Center" />
                    <ComboBox x:Name="KeyPttBox" Grid.Row="2" Grid.Column="1" SelectionChanged="OnPinChanged" />
                    <TextBlock Grid.Row="3" Text="Manipulare:" VerticalAlignment="Center" />
                    <ComboBox x:Name="KeyPinBox" Grid.Row="3" Grid.Column="1" SelectionChanged="OnPinChanged"
                              ToolTip="FSK pentru RTTY, keying pentru CW" />
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                           Text="La FTX-1 de obicei al doilea port (Standard): PTT pe un pin, manipularea pe celalalt (ex. PTT pe RTS, FSK pe DTR, ca in aplicatia Android). PTT-ul se alege intr-un singur loc: aici sau la portul CAT." />
            </StackPanel>
        </Border>

    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>