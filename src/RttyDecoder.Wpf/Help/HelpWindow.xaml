<Window x:Class="RttyDecoder.Wpf.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajutor - RTTY Decoder" Width="980" Height="680" MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="{DynamicResource Rtty.Background}" Foreground="{DynamicResource Rtty.Foreground}"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RttyDecoder.Wpf;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" MinWidth="160" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="Cauta:" Foreground="{DynamicResource Rtty.Muted}" Margin="0,0,0,2" />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource Rtty.Input}" Height="24" Margin="0,0,0,6"
                     TextChanged="OnSearchChanged" ToolTip="Cuvinte din titlu sau din text (fara diacritice e la fel)" />
            <TextBlock x:Name="NoResults" DockPanel.Dock="Top" Text="Nimic gasit." Foreground="{DynamicResource Rtty.Muted}"
                       Visibility="Collapsed" Margin="2,0,0,4" />
            <ListBox x:Name="TopicList" DisplayMemberPath="Title" SelectionChanged="OnTopicSelected"
                     Background="{DynamicResource Rtty.Panel}" Foreground="{DynamicResource Rtty.Foreground}"
                     BorderBrush="{DynamicResource Rtty.Border}" FontSize="13" />
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />
        <Border Grid.Column="2" BorderBrush="{DynamicResource Rtty.Border}" BorderThickness="1" Background="{DynamicResource Rtty.Panel}">
            <FlowDocumentScrollViewer x:Name="Viewer" VerticalScrollBarVisibility="Auto" IsToolBarVisible="False" />
        </Border>
    </Grid>
</Window>
