<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Rtty.Background" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Rtty.Panel" Color="#2A2A2A" />
    <SolidColorBrush x:Key="Rtty.Border" Color="#3C3C3C" />
    <SolidColorBrush x:Key="Rtty.Foreground" Color="#E6E6E6" />
    <SolidColorBrush x:Key="Rtty.Muted" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Rtty.Accent" Color="#00E5FF" />
    <SolidColorBrush x:Key="Rtty.Primary" Color="#007ACC" />
    <SolidColorBrush x:Key="Rtty.On" Color="#00897B" />
    <SolidColorBrush x:Key="Rtty.Hover" Color="#3A3A3A" />

    <!-- Indicative in terminal: text + fundal discret (textul obisnuit e deja verde) -->
    <SolidColorBrush x:Key="Call.FormatOnly" Color="#FFD700" />
    <SolidColorBrush x:Key="Call.FormatOnly.Back" Color="#332B00" />
    <SolidColorBrush x:Key="Call.Known" Color="#69F0AE" />
    <SolidColorBrush x:Key="Call.Known.Back" Color="#123826" />
    <SolidColorBrush x:Key="Call.Own" Color="#FF8A65" />
    <SolidColorBrush x:Key="Call.Own.Back" Color="#3A1F15" />

    <Style TargetType="ButtonBase" x:Key="Rtty.ButtonBase">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="#424242" />
        <Setter Property="BorderBrush" Value="{StaticResource Rtty.Border}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#8A8A8A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource Rtty.ButtonBase}" />

    <Style TargetType="Button" x:Key="Rtty.PrimaryButton" BasedOn="{StaticResource Rtty.ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Rtty.Primary}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style TargetType="ToggleButton" BasedOn="{StaticResource Rtty.ButtonBase}">
        <Setter Property="MinWidth" Value="52" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{StaticResource Rtty.On}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Rtty.Foreground}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Margin" Value="2" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Margin" Value="4,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource Rtty.Panel}" />
        <Setter Property="Foreground" Value="#43A047" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Rtty.Label">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style TargetType="TextBlock" x:Key="Rtty.Value">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Rtty.Accent}" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <Style TargetType="TextBox" x:Key="Rtty.Input">
        <Setter Property="Background" Value="#101010" />
        <Setter Property="Foreground" Value="{StaticResource Rtty.Foreground}" />
        <Setter Property="CaretBrush" Value="{StaticResource Rtty.Foreground}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rtty.Border}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="DataGrid" x:Key="Rtty.Grid">
        <Setter Property="Background" Value="Black" />
        <Setter Property="Foreground" Value="{StaticResource Rtty.Foreground}" />
        <Setter Property="RowBackground" Value="Black" />
        <Setter Property="AlternatingRowBackground" Value="#121212" />
        <Setter Property="BorderBrush" Value="{StaticResource Rtty.Border}" />
        <Setter Property="HorizontalGridLinesBrush" Value="#262626" />
        <Setter Property="VerticalGridLinesBrush" Value="#262626" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="AutoGenerateColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="SelectionUnit" Value="FullRow" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource Rtty.Panel}" />
        <Setter Property="Foreground" Value="{StaticResource Rtty.Muted}" />
        <Setter Property="BorderBrush" Value="{StaticResource Rtty.Border}" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#263238" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#202020" />
    </Style>
</ResourceDictionary>
