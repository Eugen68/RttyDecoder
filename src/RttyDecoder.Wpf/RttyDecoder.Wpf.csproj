<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>RttyDecoder.Wpf</RootNamespace>
    <Description>Interfata WPF a decodorului RTTY (UserControl de inclus in alte aplicatii): waterfall, terminal cu indicative evidentiate, lista statiilor, comenzi.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RttyDecoder.Core\RttyDecoder.Core.csproj" />
    <ProjectReference Include="..\RttyDecoder.Audio\RttyDecoder.Audio.csproj" />
    <ProjectReference Include="..\..\external\HamCallsign\src\HamCallsign\HamCallsign.csproj" />
    <ProjectReference Include="..\..\external\HamCallsign\src\HamCallsign.Online\HamCallsign.Online.csproj" />
    <ProjectReference Include="..\..\external\HamRig\src\HamRig\HamRig.csproj" />
    <ProjectReference Include="../../external/HamContest/src/HamContest/HamContest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RttyDecoder.Wpf.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Subiectele de ajutor: Help/Topics/NN-nume.md (ordinea dupa NN); un subiect nou = un fisier nou. -->
    <EmbeddedResource Include="Help\Topics\*.md" LogicalName="RttyDecoder.Wpf.Help.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../external/HamContest/samples/DEMO-RTTY.udc" LogicalName="RttyDecoder.Contest.DEMO-RTTY.udc" />
    <EmbeddedResource Include="../../external/HamContest/samples/DEMO.sec" LogicalName="RttyDecoder.Contest.DEMO.sec" />
  </ItemGroup>
</Project>
