<Window x:Class="RttyDecoder.Wpf.MacroEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Macro" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Rtty.Background}" Foreground="{DynamicResource Rtty.Foreground}"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RttyDecoder.Wpf;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Nume:" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" Style="{StaticResource Rtty.Input}" Height="24" MaxLength="12"
                     ToolTip="Numele scurt de pe buton" />
        </Grid>
        <TextBlock Text="Text:" Margin="0,10,0,4" />
        <TextBox x:Name="TextBox" Style="{StaticResource Rtty.Input}" Height="90" FontFamily="Consolas" FontSize="14"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" CharacterCasing="Upper"
                 VerticalScrollBarVisibility="Auto" />
        <TextBlock Foreground="{StaticResource Rtty.Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="Variabile: {MYCALL} indicativul tau (campul din lista statiilor), {CALL} ultimul indicativ pe care ai dat click (terminal sau lista), {RST} 599. Enter in text = rand nou. CR/LF automat la inceputul si sfarsitul emisiei se alege in Setari transmisie." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Implicit" Width="90" Click="OnDefault" ToolTip="Textul implicit al acestui macro" />
            <Button Content="Anuleaza" Width="90" IsCancel="True" />
            <Button Content="Salveaza" Width="90" IsDefault="True" Style="{StaticResource Rtty.PrimaryButton}" Click="OnSave" />
        </StackPanel>
    </StackPanel>
</Window>
