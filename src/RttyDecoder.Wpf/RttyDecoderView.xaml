<UserControl x:Class="RttyDecoder.Wpf.RttyDecoderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:RttyDecoder.Wpf"
             mc:Ignorable="d"
             d:DesignWidth="1000" d:DesignHeight="700"
             Background="{DynamicResource Rtty.Background}"
             Foreground="{DynamicResource Rtty.Foreground}"
             FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/RttyDecoder.Wpf;component/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- sursa -->
            <RowDefinition Height="Auto" />   <!-- stare -->
            <RowDefinition Height="Auto" />   <!-- waterfall + reglajele lui -->
            <RowDefinition Height="Auto" />   <!-- comenzi -->
            <RowDefinition Height="Auto" />   <!-- reglaje -->
            <RowDefinition Height="*" />      <!-- terminal -->
            <RowDefinition Height="Auto" />   <!-- macro-uri -->
            <RowDefinition Height="Auto" />   <!-- emisie -->
            <RowDefinition Height="Auto" />   <!-- mesaj -->
        </Grid.RowDefinitions>

        <!-- SURSA AUDIO -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Intrare:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox DockPanel.Dock="Left" Width="300" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                      IsEnabled="{Binding IsRunning, Converter={x:Static local:Converters.Not}}" ToolTip="Placa de sunet / interfata radio / cablu audio virtual" />
            <Button DockPanel.Dock="Left" Content="&#x21BB;" Width="28" Command="{Binding RefreshDevicesCommand}" ToolTip="Reciteste lista placilor de sunet"
                    IsEnabled="{Binding IsRunning, Converter={x:Static local:Converters.Not}}" />
            <TextBlock DockPanel.Dock="Left" Text="Canal:" VerticalAlignment="Center" Margin="12,0,6,0" />
            <ComboBox DockPanel.Dock="Left" Width="70" ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}"
                      IsEnabled="{Binding IsRunning, Converter={x:Static local:Converters.Not}}" ToolTip="Canalul folosit dintr-o sursa stereo" />
            <Button DockPanel.Dock="Left" Margin="12,0,0,0" Width="90" Content="{Binding StartStopText}" Command="{Binding StartStopCommand}"
                    Style="{StaticResource Rtty.PrimaryButton}" ToolTip="Porneste / opreste receptia de la placa de sunet" />
            <CheckBox DockPanel.Dock="Left" Margin="12,0,0,0" VerticalAlignment="Center" Content="Timp real" IsChecked="{Binding RealTime}"
                      ToolTip="Bifat: fisierul se reda in ritmul real. Debifat: decodare cat de repede se poate." />
            <ToggleButton DockPanel.Dock="Left" Margin="12,2,2,2" Content="&#x1F50A; MONITOR" IsChecked="{Binding MonitorOn}"
                          ToolTip="Semnalul primit se aude in difuzoare (placa de iesire implicita). Atentie: daca intrarea e chiar iesirea placii (Stereo Mix, cablu virtual), apare reactie." />
            <Slider DockPanel.Dock="Left" Width="80" Minimum="0" Maximum="100" Value="{Binding MonitorVolume}" VerticalAlignment="Center"
                    ToolTip="Volumul monitorizarii" />
            <TextBlock DockPanel.Dock="Left" Text="UTC" Margin="20,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource Rtty.Muted}" />
            <TextBlock x:Name="UtcClock" DockPanel.Dock="Left" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource Rtty.Accent}" ToolTip="Ora UTC" />
            <TextBlock DockPanel.Dock="Left" Text="LOCAL" Margin="16,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource Rtty.Muted}" />
            <TextBlock x:Name="LocalClock" DockPanel.Dock="Left" VerticalAlignment="Center" FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                       Foreground="{StaticResource Rtty.Foreground}" ToolTip="Ora locala a calculatorului" />
            <ProgressBar DockPanel.Dock="Left" Margin="8,0,0,0" Width="140" Height="10" Minimum="0" Maximum="1" Value="{Binding FileProgress, Mode=OneWay}"
                         Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}" />
        </DockPanel>

        <!-- STARE -->
        <DockPanel Grid.Row="1" Margin="0,0,0,4" LastChildFill="True">
            <TextBlock DockPanel.Dock="Left" Text="{Binding MarkText}" Foreground="{StaticResource Rtty.Accent}" FontWeight="Bold" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding SnrText}" Margin="20,0,0,0" Foreground="{StaticResource Rtty.Accent}" FontWeight="Bold" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding LevelText}" Margin="20,0,6,0" />
            <ProgressBar DockPanel.Dock="Left" Width="90" Height="8" Minimum="-60" Maximum="0" Value="{Binding InputLevelDb, Mode=OneWay}"
                         ToolTip="Nivelul de intrare. Ideal intre -30 si -6 dBFS; la 0 dBFS semnalul e taiat." />
            <Border DockPanel.Dock="Left" Margin="20,0,0,0" Padding="6,0" CornerRadius="2" Background="#B71C1C"
                    Visibility="{Binding RigTransmitting, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="TX" FontWeight="Bold" Foreground="White" />
            </Border>
            <TextBlock DockPanel.Dock="Left" Text="{Binding RigText}" Margin="12,0,0,0" FontWeight="Bold" ToolTip="{Binding RigToolTip}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Rtty.Muted}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RigConnected}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Call.FormatOnly}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="{Binding SourceName}" HorizontalAlignment="Right" Foreground="{StaticResource Rtty.Muted}" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <!-- WATERFALL: timpul este timpul audio, nu numarul cadrelor desenate -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="{Binding Value, ElementName=WaterfallHeight}" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource Rtty.Border}" BorderThickness="1">
                <local:WaterfallControl x:Name="Waterfall"
                    MarkFrequencyHz="{Binding MarkFrequencyHz, Mode=OneWay}" Reverse="{Binding Reverse, Mode=OneWay}"
                    FrequencyCommand="{Binding SetFrequencyCommand}" QsyCommand="{Binding QsyCommand}"
                    ToolTip="Click: acordul decodorului. Rotita: 1 Hz, Ctrl: 10 Hz. Alt+rotita: zoom la cursor. Alt+tragere sau buton mijlociu: deplasare. Shift+click: QSY explicit, numai cu statia conectata. A-TUNE calculeaza frecventa de raspuns; optiunea QSY inainte de TX este separata."
                    ToolTipService.InitialShowDelay="1200" />
            </Border>
            <Border Grid.Column="1" Margin="8,0,0,0" BorderBrush="{StaticResource Rtty.Border}" BorderThickness="1">
                <local:TuningIndicator x:Name="Tuning" />
            </Border>
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,4,0,0">
                <Button Content="0–4 kHz" Click="OnWaterfallFull" ToolTip="Vedere generala, fara stergerea istoricului" />
                <Button Content="Semnal" Click="OnWaterfallCenter" ToolTip="Zoom pe perechea Mark/Space" />
                <Button Content="+" Width="28" Click="OnWaterfallZoomIn" />
                <Button Content="−" Width="28" Click="OnWaterfallZoomOut" />
                <TextBlock Text="Istoric:" VerticalAlignment="Center" Margin="8,0,4,0" />
                <ComboBox x:Name="WaterfallHistory" Width="64" ItemsSource="{x:Static local:WaterfallOptions.Durations}"
                          DisplayMemberPath="Label" SelectedValuePath="Seconds" SelectedValue="{Binding HistorySeconds, ElementName=Waterfall}" />
                <TextBlock Text="FFT:" VerticalAlignment="Center" Margin="8,0,4,0" />
                <ComboBox x:Name="WaterfallResolution" Width="115" ItemsSource="{x:Static local:WaterfallOptions.Resolutions}"
                          DisplayMemberPath="Label" SelectedValuePath="Size" SelectedValue="{Binding SpectrumSize, ElementName=Waterfall}" />
                <CheckBox Content="Urmeaza" IsChecked="{Binding FollowSignal, ElementName=Waterfall}" VerticalAlignment="Center" Margin="8,0,4,0"
                          ToolTip="In zoom, centrul urmareste acordul. Deplasarea manuala dezactiveaza urmarirea." />
                <ToggleButton Content="Pauza imagine" IsChecked="{Binding IsPaused, ElementName=Waterfall}" ToolTip="Ingheata imaginea; receptia si istoricul live continua" />
                <Button Content="PNG..." Click="OnWaterfallCapture" ToolTip="Salveaza imaginea afisata, cu axe si markeri" />
                <TextBlock x:Name="WaterfallStatus" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource Rtty.Muted}" />
            </WrapPanel>
            <Expander Grid.Row="2" Grid.ColumnSpan="2" Header="Afisare waterfall: niveluri, paleta si inaltime" Margin="0,2,0,0">
                <WrapPanel Margin="0,4,0,4">
                    <TextBlock Text="Podea:" Style="{StaticResource Rtty.Label}" />
                    <CheckBox Content="Auto" VerticalAlignment="Center" Margin="0,0,6,0"
                        IsChecked="{Binding AutoFloor, ElementName=Waterfall}" Checked="OnAutoFloorChanged" Unchecked="OnAutoFloorChanged" />
                    <Slider x:Name="FloorSlider" Width="100" Minimum="-160" Maximum="0" Value="{Binding FloorDb, ElementName=Waterfall}"
                        IsEnabled="{Binding AutoFloor, ElementName=Waterfall, Converter={x:Static local:Converters.Not}}" />
                    <TextBlock x:Name="FloorText" Style="{StaticResource Rtty.Value}" Width="70" />
                    <CheckBox Content="Fixeaza nivel" IsChecked="{Binding LockLevels, ElementName=Waterfall}" VerticalAlignment="Center" Margin="6,0,6,0"
                        ToolTip="Opreste urmarirea automata a zgomotului; util pentru compararea semnalelor" />
                    <TextBlock Text="Interval:" Style="{StaticResource Rtty.Label}" Margin="8,0,4,0" />
                    <Slider Width="85" Minimum="10" Maximum="120" Value="{Binding RangeDb, ElementName=Waterfall}" />
                    <TextBlock Text="{Binding RangeDb, ElementName=Waterfall, StringFormat={}{0:0} dB}" Style="{StaticResource Rtty.Value}" Width="45" />
                    <TextBlock Text="Gama:" Style="{StaticResource Rtty.Label}" Margin="8,0,4,0" />
                    <Slider Width="70" Minimum="0.2" Maximum="3" Value="{Binding Gamma, ElementName=Waterfall}"
                        ToolTip="Peste 1: intuneca nivelurile slabe. Sub 1: le evidentiaza. Curba afecteaza intensitatea, nu numai nuanta." />
                    <TextBlock Text="{Binding Gamma, ElementName=Waterfall, StringFormat={}{0:0.0}x}" Style="{StaticResource Rtty.Value}" Width="32" />
                    <TextBlock Text="Paleta:" Style="{StaticResource Rtty.Label}" Margin="8,0,4,0" />
                    <ComboBox Width="90" SelectedValuePath="Tag" SelectedValue="{Binding Palette, ElementName=Waterfall}">
                        <ComboBoxItem Content="Contrast" Tag="{x:Static local:WaterfallPalette.Contrast}" />
                        <ComboBoxItem Content="Clasica" Tag="{x:Static local:WaterfallPalette.Classic}" />
                    </ComboBox>
                    <CheckBox Content="Spectru" IsChecked="{Binding ShowSpectrum, ElementName=Waterfall}" VerticalAlignment="Center" Margin="8,0,6,0" />
                    <CheckBox Content="Atragere pe semnal" IsChecked="{Binding SnapToSignal, ElementName=Waterfall}" VerticalAlignment="Center" Margin="8,0,6,0"
                        ToolTip="La click cauta o pereche RTTY apropiata. Foloseste NORM/REV curent; nu comanda QSY." />
                    <TextBlock Text="Inaltime:" Style="{StaticResource Rtty.Label}" Margin="8,0,4,0" />
                    <Slider x:Name="WaterfallHeight" Width="90" Minimum="160" Maximum="400" Value="230" />
                    <TextBlock x:Name="SignalText" Style="{StaticResource Rtty.Value}" FontFamily="Consolas" Margin="8,0,0,0"
                        ToolTip="Minim/maxim in intervalul vizibil; amplitudine spectrala dBFS, nu nivelul RMS al intregului audio" />
                </WrapPanel>
            </Expander>
        </Grid>

        <!-- COMENZI -->
        <WrapPanel Grid.Row="3" Margin="0,6,0,0" Orientation="Horizontal">
            <Button Width="64" Content="{Binding ReverseText}" Command="{Binding ReverseCommand}" ToolTip="NORM / REV (Space sub Mark)" />
            <Button Width="72" Content="A-TUNE" Command="{Binding AutoTuneCommand}" Style="{StaticResource Rtty.PrimaryButton}" MouseDoubleClick="OnAtuneDoubleClick"
                    ToolTip="Click: acord automat pe cel mai puternic semnal RTTY (Mark-ul real, NORM/REV dupa semnal) si calculul frecventei statiei pentru emisie. Dublu click: muta statia acolo - Mark-ul semnalului pe 2125, emisia FSK pe frecventa corespondentului." />
            <TextBlock Text="Decodor:" VerticalAlignment="Center" Margin="12,0,4,0" />
            <ComboBox Width="130" ItemsSource="{Binding Decoders}" SelectedItem="{Binding Decoder}"
                      ToolTip="Chebyshev (implicit, bun si la flutter), Matched Filter (cel mai bun clasic pe semnal slab si fading lent) sau DeepRTTY (model neural, cel mai bun; text provizoriu cu gri, confirmat dupa ~8-12 s)" />
            <TextBlock Text="Profil:" VerticalAlignment="Center" Margin="12,0,4,0" />
            <ComboBox Width="195" ItemsSource="{Binding ReceptionProfiles}" DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedReceptionProfile}" ToolTip="{Binding SelectedReceptionProfile.Description}" />
            <TextBlock Text="Urmarire:" VerticalAlignment="Center" Margin="12,0,4,0" />
            <ComboBox Width="64" ItemsSource="{Binding TrackingModes}" SelectedItem="{Binding Tracking}" ToolTip="AFC lent / PLL rapid" />
            <ToggleButton Margin="12,2,2,2" Content="NB" IsChecked="{Binding NoiseBlanker}" ToolTip="NB: reduce impulsurile in decodorul clasic. La DeepRTTY afecteaza numai SNR/AFC, nu audio-ul modelului." />
            <ToggleButton Content="DNR" IsChecked="{Binding Dnr}" ToolTip="DNR: bandpass intre Mark si Space pentru decodorul clasic. La DeepRTTY afecteaza numai SNR/AFC, nu audio-ul modelului." />
            <ToggleButton Content="SNR-G" IsChecked="{Binding SnrGating}" IsEnabled="{Binding IsClassic}" ToolTip="La semnal sub prag, decizia ramane pe Mark (idle)" />
            <ToggleButton Content="SQL" IsChecked="{Binding Squelch}" IsEnabled="{Binding IsClassic}"
                          ToolTip="Squelch: textul apare doar cand caracterele vin in ritmul RTTY (semnal real), nu pe zgomot. Nu schimba decodarea; inceputul mesajului nu se pierde. Pragul in Reglaje. (Chebyshev si Matched Filter; DeepRTTY are filtrul lui.)" />
            <ToggleButton Content="ATC" IsChecked="{Binding Atc}" IsEnabled="{Binding IsChebyshevDecoder}" ToolTip="ATC W7AY - pentru fading selectiv (Chebyshev; Matched Filter isi normalizeaza singur tonurile)" />
            <ToggleButton Content="Volant" IsChecked="{Binding Flywheel}" IsEnabled="{Binding IsClassic}" ToolTip="Sincronizare pe caracter la RTTY continuu" />
            <ToggleButton Content="US-TTY" IsChecked="{Binding UsTty}" ToolTip="Tabelul FIGS US-TTY (apostrof, ghilimele, $) in loc de ITA2" />
            <Button Margin="12,2,2,2" Width="64" Content="CLEAR" Command="{Binding ClearCommand}" />
            <Button Width="80" Content="Salveaza..." Click="OnSaveText" ToolTip="Salveaza textul receptionat intr-un fisier .txt" />
            <ToggleButton Margin="12,2,2,2" Content="Statii" IsChecked="{Binding ShowStations}" ToolTip="Lista statiilor auzite (indicativele din text)" />
            <ToggleButton x:Name="AdvancedToggle" Margin="12,2,2,2" Content="Reglaje" ToolTip="Arata pragurile si latimile filtrelor" />
        </WrapPanel>

        <!-- REGLAJE -->
        <Grid Grid.Row="4" Margin="0,6,0,0" Visibility="{Binding IsChecked, ElementName=AdvancedToggle, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="3" Grid.ColumnSpan="7" Text="{Binding DecoderHelp}" TextWrapping="Wrap"
                       Foreground="{StaticResource Rtty.Muted}" Margin="0,6,0,0" />
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Sensibilitate" Style="{StaticResource Rtty.Label}" />
            <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SensitivityPercent}" IsEnabled="{Binding IsClassic}" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SensitivityPercent, StringFormat={}{0:0} %}" Style="{StaticResource Rtty.Value}" />

            <TextBlock Grid.Row="0" Grid.Column="4" Text="Latime filtru" Style="{StaticResource Rtty.Label}" />
            <Slider Grid.Row="0" Grid.Column="5" Minimum="54.5" Maximum="114.6" Value="{Binding FilterWidthHz}" IsEnabled="{Binding IsChebyshev}" />
            <TextBlock Grid.Row="0" Grid.Column="6" Text="{Binding FilterWidthHz, StringFormat=~{0:0} Hz}" Style="{StaticResource Rtty.Value}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Prag NB" Style="{StaticResource Rtty.Label}" />
            <Slider Grid.Row="1" Grid.Column="1" Minimum="2" Maximum="12" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding NoiseBlankerThreshold}" IsEnabled="{Binding NoiseBlanker}" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding NoiseBlankerThreshold, StringFormat=x{0:0.0}}" Style="{StaticResource Rtty.Value}" />

            <TextBlock Grid.Row="1" Grid.Column="4" Text="Latime DNR" Style="{StaticResource Rtty.Label}" />
            <Slider Grid.Row="1" Grid.Column="5" Minimum="250" Maximum="1500" TickFrequency="62.5" IsSnapToTickEnabled="True" Value="{Binding DnrWidthHz}" IsEnabled="{Binding Dnr}" />
            <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding DnrWidthHz, StringFormat=~{0:0} Hz}" Style="{StaticResource Rtty.Value}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Prag SNR-G" Style="{StaticResource Rtty.Label}" />
            <Slider Grid.Row="2" Grid.Column="1" Minimum="1" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding SnrGatingK}" IsEnabled="{Binding CanAdjustSnrGate}" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SnrGatingK, StringFormat=x{0:0.0}}" Style="{StaticResource Rtty.Value}" />

            <TextBlock Grid.Row="2" Grid.Column="4" Text="Prag SQL" Style="{StaticResource Rtty.Label}" />
            <Slider Grid.Row="2" Grid.Column="5" Minimum="10" Maximum="80" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SquelchPercent}"
                    IsEnabled="{Binding CanAdjustSquelch}"
                    ToolTip="Proportia minima de caractere in ritm ca textul sa apara. Mai mic = deschide mai usor (si pe semnale tastate rar); mai mare = mai putin gunoi. Implicit 35%." />
            <TextBlock Grid.Row="2" Grid.Column="6" Text="{Binding SquelchPercent, StringFormat={}{0:0} %}" Style="{StaticResource Rtty.Value}" />

        </Grid>

        <!-- TERMINAL + STATII AUZITE -->
        <Grid Grid.Row="5" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="StationsColumn" Width="380" MinWidth="0" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Black" BorderBrush="{StaticResource Rtty.Border}" BorderThickness="1">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding DecoderQueueText}" Foreground="{StaticResource Rtty.Muted}"
                               FontSize="11" Margin="0,2,0,0" />
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ProvisionalText}" Foreground="#808080" FontFamily="Consolas" FontSize="15"
                               Margin="6,0,6,4" TextWrapping="Wrap" ToolTip="DeepRTTY: text provizoriu, inca neconfirmat" />
                    <RichTextBox x:Name="Terminal" IsReadOnly="True" IsReadOnlyCaretVisible="False" Background="Black" Foreground="#00FF00"
                                 BorderThickness="0" FontFamily="Consolas" FontSize="15" VerticalScrollBarVisibility="Auto"
                                 Padding="4" AcceptsReturn="True"
                                 PreviewMouseLeftButtonUp="OnTerminalClick" PreviewMouseDoubleClick="OnTerminalDoubleClick"
                                 MouseMove="OnTerminalMouseMove">
                        <FlowDocument PagePadding="0">
                            <Paragraph x:Name="TerminalParagraph" Margin="0" />
                        </FlowDocument>
                    </RichTextBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                          Visibility="{Binding ShowStations, Converter={StaticResource BoolToVis}}" />

            <DockPanel Grid.Column="2" Visibility="{Binding ShowStations, Converter={StaticResource BoolToVis}}">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="Indicativul meu:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox DockPanel.Dock="Left" Width="90" Style="{StaticResource Rtty.Input}" CharacterCasing="Upper"
                             Text="{Binding MyCall, UpdateSourceTrigger=LostFocus}" KeyDown="OnMyCallKeyDown"
                             ToolTip="Indicativul propriu: apare cu portocaliu in terminal si nu intra in lista" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding StationsText}" VerticalAlignment="Center" Foreground="{StaticResource Rtty.Muted}" />
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Content="CSV..." Click="OnSaveStations" ToolTip="Salveaza lista statiilor (CSV, ore UTC)" />
                    <Button DockPanel.Dock="Left" Content="Goleste" Command="{Binding ClearStationsCommand}" ToolTip="Goleste lista statiilor" />
                    <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource Rtty.Muted}" FontSize="11">
                        <Run Text="&#x25A0;" Foreground="{StaticResource Call.Known}" /><Run Text=" cunoscut / confirmat  " />
                        <Run Text="&#x25A0;" Foreground="{StaticResource Call.FormatOnly}" /><Run Text=" necunoscut" />
                    </TextBlock>
                </DockPanel>
                <DataGrid x:Name="StationsGrid" Style="{StaticResource Rtty.Grid}" ItemsSource="{Binding HeardStationsView}"
                          PreviewMouseLeftButtonUp="OnStationClick" MouseDoubleClick="OnStationDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            <Setter Property="Cursor" Value="Hand" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Indicativ" Binding="{Binding Call}" SortMemberPath="Call" Width="Auto" MinWidth="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{StaticResource Call.FormatOnly}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConfirmed}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Call.Known}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Tara" Binding="{Binding Country}" Width="*" />
                        <DataGridTextColumn Header="Cont" Binding="{Binding Continent}" Width="Auto" />
                        <DataGridTextColumn Header="CQ" Binding="{Binding CqZone}" Width="Auto" />
                        <DataGridTextColumn Header="Nr" Binding="{Binding Count}" Width="Auto" />
                        <DataGridTextColumn Header="Prima UTC" Binding="{Binding FirstHeardUtc, StringFormat=HH:mm}" Width="Auto" />
                        <DataGridTextColumn Header="Ultima UTC" Binding="{Binding LastHeardUtc, StringFormat=HH:mm}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <!-- MACRO-URI (F1..F8), de la stanga -->
        <ItemsControl Grid.Row="6" Margin="0,6,0,0" ItemsSource="{Binding Macros}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button MinWidth="96" Margin="0,0,4,0" HorizontalContentAlignment="Left"
                            Command="{Binding DataContext.MacroCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" ToolTip="{Binding ToolTip}" MouseRightButtonUp="OnEditMacro">
                        <TextBlock>
                            <Run Text="{Binding Key, Mode=OneWay}" Foreground="{StaticResource Rtty.Accent}" FontWeight="Bold" />
                            <Run Text="{Binding Name, Mode=OneWay}" />
                        </TextBlock>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- EMISIE -->
        <DockPanel Grid.Row="7" Margin="0,4,0,0">
            <Button DockPanel.Dock="Right" Content="STOP (Esc)" Command="{Binding StopTxCommand}" ToolTip="Opreste imediat emisia (Esc)">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                                <Setter Property="Background" Value="#B71C1C" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button DockPanel.Dock="Right" Content="Trimite" Command="{Binding SendTextCommand}" ToolTip="Trimite textul (Enter)" />
            <ToggleButton DockPanel.Dock="Right" Content="LIVE" IsChecked="{Binding LiveMode}"
                          ToolTip="LIVE: emisia sta pornita, fiecare caracter pleaca imediat ce il scrii (diddle intre ele)" />
            <TextBox x:Name="TxBox" Style="{StaticResource Rtty.Input}" FontFamily="Consolas" FontSize="15" Height="28" Margin="0,2,4,2"
                     Text="{Binding TxText, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"
                     PreviewKeyDown="OnTxKeyDown" PreviewTextInput="OnTxTextInput"
                     ToolTip="Text de trimis: Enter = trimite. In LIVE, caracterele pleaca pe masura ce scrii. Variabile: {MYCALL} {CALL} {RST}" />
        </DockPanel>

        <TextBlock Grid.Row="8" Margin="0,4,0,0" Text="{Binding Message}" Foreground="{StaticResource Rtty.Muted}" TextTrimming="CharacterEllipsis" />
    </Grid>
</UserControl>
