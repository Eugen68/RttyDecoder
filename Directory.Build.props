<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>Eugen Trifu, YO9VA</Authors>
    <Copyright>Copyright (c) 2026 Eugen Trifu, YO9VA</Copyright>
    <!-- Permite compilarea proiectelor WPF si pe Linux/macOS (CI, teste); rularea ramane doar pe Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
